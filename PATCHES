 tests/test_onejob_lock_exit.c | 27 ++++++++++++++++++++-------
 1 file changed, 20 insertions(+), 7 deletions(-)

diff --git a/tests/test_onejob_lock_exit.c b/tests/test_onejob_lock_exit.c
index 10d98fe..25609d2 100644
--- a/tests/test_onejob_lock_exit.c
+++ b/tests/test_onejob_lock_exit.c
@@ -13,15 +13,22 @@
