 tests/run.sh                  |  6 ++-
 tests/test_lock_eintr_retry.c | 83 +++++++++++++++++++++++++++++++++++
 3 files changed, 109 insertions(+), 7 deletions(-)
 create mode 100644 tests/test_lock_eintr_retry.c

